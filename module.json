{
    "id": "foundrymagic",
    "title": "FoundryMagic",
    "description": "Unified D&D Beyond import module that combines character, adventure, monster, spell, and item import capabilities into a single standalone module for Foundry VTT.",
    "version": "1.0.0",
    "library": false,
    "manifestPlusVersion": "1.2.0",
    "compatibility": {
        "minimum": "10",
        "verified": "12",
        "maximum": "12"
    },
    "authors": [
        {
            "name": "FoundryMagic Team",
            "email": "support@foundrymagic.com"
        }
    ],
    "esmodules": [
        "src/index.js"
    ],
    "styles": [
        "styles/foundrymagic.css"
    ],
    "languages": [
        {
            "lang": "en",
            "name": "English",
            "path": "lang/en.json"
        }
    ],
    "system": [
        "dnd5e"
    ],
    "dependencies": [
        {
            "name": "dnd5e",
            "type": "system",
            "manifest": "https://github.com/foundryvtt/dnd5e/releases/latest/download/system.json",
            "compatibility": {
                "minimum": "2.0.0",
                "verified": "3.0.0"
            }
        }
    ],
    "socket": false,
    "url": "https://github.com/foundrymagic/foundrymagic",
    "manifest": "https://github.com/foundrymagic/foundrymagic/releases/latest/download/module.json",
    "download": "https://github.com/foundrymagic/foundrymagic/releases/latest/download/foundrymagic.zip",
    "license": "LICENSE",
    "readme": "README.md",
    "media": [
        {
            "type": "icon",
            "url": "images/foundrymagic-icon.png"
        },
        {
            "type": "cover",
            "url": "images/foundrymagic-cover.jpg"
        }
    ]
}