{
    "name": "foundrymagic",
    "version": "1.0.0",
    "description": "Unified Foundry VTT module for comprehensive D&D Beyond integration with character sheets, monsters, spells, items, and encounters.",
    "type": "module",
    "main": "src/index.js",
    "scripts": {
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "lint": "eslint src/ tests/",
        "lint:fix": "eslint src/ tests/ --fix",
        "format": "prettier --write \"src/**/*.{js,ts}\" \"tests/**/*.{js,ts}\"",
        "format:check": "prettier --check \"src/**/*.{js,ts}\" \"tests/**/*.{js,ts}\"",
        "build": "echo 'No build step required for Foundry VTT module'",
        "dev": "echo 'Copy src/ to Foundry Data/modules/foundrymagic/ for development'",
        "typecheck": "tsc --noEmit",
        "validate": "npm run lint && npm run format:check && npm run typecheck && npm run test"
    },
    "keywords": [
        "foundry-vtt",
        "dnd5e",
        "dnd-beyond",
        "character-import",
        "module",
        "rpg"
    ],
    "author": "FoundryMagic Development Team",
    "license": "MIT",
    "dependencies": {
        "dotenv": "^17.2.2",
        "fake-indexeddb": "^4.0.2",
        "node-fetch": "^3.3.2"
    },
    "devDependencies": {
        "@babel/core": "^7.28.4",
        "@babel/preset-env": "^7.28.3",
        "@babel/preset-typescript": "^7.23.3",
        "@types/jest": "^29.5.5",
        "@typescript-eslint/eslint-plugin": "^6.7.5",
        "@typescript-eslint/parser": "^6.7.5",
        "babel-jest": "^30.1.2",
        "eslint": "^8.48.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-jest": "^27.4.2",
        "jest": "^29.6.4",
        "jest-environment-jsdom": "^29.6.4",
        "prettier": "^3.0.3",
        "typescript": "5.3.3"
    },
    "engines": {
        "node": ">=16.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/foundrymagic/foundrymagic.git"
    },
    "bugs": {
        "url": "https://github.com/foundrymagic/foundrymagic/issues"
    },
    "homepage": "https://github.com/foundrymagic/foundrymagic#readme",
    "foundry": {
        "compatibility": {
            "minimum": "10.0.0",
            "verified": "11.0.0",
            "maximum": "12.0.0"
        },
        "system": [
            "dnd5e"
        ]
    }
}
